# Copy securely to /srv/docker/apps/fitness/secrets/runtime.env, chmod 600.
# Generate independently: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
DEBUG=false
ALLOWED_HOSTS=hp800-g5.tail985cfd.ts.net,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://hp800-g5.tail985cfd.ts.net:8443
POSTGRES_DB=fitness
POSTGRES_USER=fitness
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DB_SECRET
